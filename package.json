{
  "name": "dvt",
  "version": "1.0.2",
  "description": "DVT",
  "main": "main.js",
  "author": "luffiz0r&gpt",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/luffiz0r/dvt-app.git"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "build": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dvt.app",
    "productName": "DVT",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "style.css",
      "renderer.js",
      "main.js",
      "preload.js",
      "server.js",
      "build/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "luffiz0r",
        "repo": "dvt-app",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}